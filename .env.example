# Origin of the LCMS backend API, no trailing slash. Read at build time: rebuild after changing it.
# The backend's CORS_ORIGINS must list the origin this app is served from (scheme, host and port);
# Vite moves to 5174, 5175... when 5173 is busy, so check the address it prints.
VITE_API_BASE_URL=http://localhost:4000

# Optional. Set to true to play a short chime when a new notification arrives, and to show the
# on/off switch on the Profile page. Anything else (or leaving it out) keeps the feature off.
# Read at build time: restart `pnpm dev` / rebuild after changing it.
VITE_NOTIFICATION_SOUND=false
